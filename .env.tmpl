OLLAMA_DATA_PATH=/home/myuser/.ollama
OLLAMA_URL=http://host.docker.internal:11434
HF_HOME_CACHE=/home/myuser/.cache/huggingface

# LLM backend. Leave LLM_URL empty to use local Ollama (above).
# To use an external OpenAI-compatible provider, set the base URL (WITHOUT the
# /v1/chat/completions suffix) and an API token. The token stays server-side.
# Example: LLM_URL=https://api.openai.com  VITE_LLM_MODEL=gpt-4o-mini
LLM_URL=
LLM_API_KEY=
VITE_LLM_MODEL=gemma4:e2b

# Set to 0 to disable
OLLAMA_REPLICAS=1
TTS_REPLICAS=1
STT_REPLICAS=1

# Set to 0.0.0.0 to expose the frontend externally (e.g. for LAN access)
# When running without Docker, set HOST=0.0.0.0 in your shell instead.
HOST_IP=127.0.0.1
